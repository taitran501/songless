# Managed Redis for immutable Daily snapshots (required before using Daily in Preview/Production).
# Vercel Marketplace Redis integrations expose the UPSTASH names; KV names are
# accepted for existing Vercel integrations.
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
# KV_REST_API_URL=https://your-instance.upstash.io
# KV_REST_API_TOKEN=your_upstash_rest_token

# Protects the Vercel Cron endpoint in Production.
# CRON_SECRET=replace-with-a-long-random-secret

# Optional local/Preview structured Daily diagnostics.
# DAILY_METRICS_LOG=1

# Optional canonical URL for result sharing.
# Falls back to window.location.origin when omitted.
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Optional anonymous product analytics. Both values are required to enable it.
# Uses localStorage persistence with autocapture and session recording disabled.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
